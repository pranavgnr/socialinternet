# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. `npm run migrate` applies db/migrations/*.sql.
# Tests don't need it: they run on in-memory PGlite instead.
# DATABASE_URL=postgres://localhost:5432/creators101
DATABASE_URL=
# Connections the shared pool may hold open. Default 5. Raise it only when the
# Postgres plan allows more; every idle socket is one the migration job cannot use.
DB_POOL_MAX=5

# ── Data layer ────────────────────────────────────────────────────────────────
# Which vendor answers. "auto" = the cheapest configured one, by the rate it
# will actually charge right now (see lib/providers/index.ts). Set to a vendor id
# to prefer it, e.g. DATA_PROVIDER=socialcrawl.
DATA_PROVIDER=auto

# Apify — Instagram. $5 free every month, then $2.70 / 1,000 results on the
# free plan ($2.30 on the $19/mo Starter plan).
# The router uses it first while the free allowance is unspent.
# https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_MONTHLY_FREE_USD=5
APIFY_ITEM_USD=0.0027
APIFY_RESULTS_LIMIT=24

# ScrapeCreators — Instagram / TikTok backup. $1.88 / 1,000 requests.
SCRAPECREATORS_API_KEY=
# What one ScrapeCreators request bills, in USD. $47 / 25,000 = $0.00188.
SCRAPECREATORS_USD_PER_CALL=0.00188

# SocialCrawl — broad, 676 endpoints, includes transcripts and comments.
# https://socialcrawl.dev — 100 free credits on signup, £15 for 2,500 credits.
# ~$0.0076 per call ⇒ about $0.07 per niche research.
SOCIALCRAWL_API_KEY=

# HikerAPI — Instagram only, the cheapest at volume.
# ADVERTISED $1/1,000, but that rate only unlocks once the balance has reached
# $100. Below that the account pays $0.02 per call, which makes a niche about
# $0.30 — four times MORE than SocialCrawl. The default below reflects the rate
# a new account really pays; set it to 0.001 after unlocking Standard.
HIKERAPI_KEY=
HIKERAPI_USD_PER_CALL=0.02
# Comments on post reads (the plan's "what people asked for" section). On by
# default: it is the second call of a post pull (+$0.02 at the Start rate).
# Set 0 to read the post without comments.
HIKERAPI_COMMENTS=1

# Validate any configured vendor against live data before trusting it (3 calls):
#   npx tsx --env-file=.env.local scripts/probe-vendor.ts --live @natgeo

# Hard ceiling per run, in vendor units. A default run needs ~8, so 12 is sane.
# This is the backstop if the balance check is ever skipped.
CREDIT_BUDGET=12
# Independent real-money ceiling per run, in USD.
CREDIT_BUDGET_USD=1.00

# ── Gem prices ────────────────────────────────────────────────────────────────
# What a creator pays per action, in gems. Overrides are whole numbers; a
# malformed value falls back to the default. The daily pool resets at IST
# midnight and never accumulates.
CREDIT_COST_NICHE=6
CREDIT_COST_HANDLE=6
CREDIT_COST_CHAT=1
CREDIT_DAILY_FREE=15

# How long a pulled sample stays valid. A warm cache makes a re-run cost 0,
# so tuning the scoring/clustering layers does not touch the balance.
HARVEST_CACHE_HOURS=12
# How long a niche pull stays fresh. A warm niche opens free; set 168 (a week)
# after a verification run so the founder can reopen it without paying again.
NICHE_CACHE_HOURS=12
# How long a handle's own feed is reused before it is read again. 12 hours is
# the live default; 168 keeps a warmed account open for a week of previews.
HANDLE_CACHE_HOURS=12
# How long a stored profile dossier is served before a fresh read is offered.
# Seven days by default; the stored view still opens with the database down.
PROFILE_CACHE_HOURS=168
# Owner follower counts bought for search results (the views ÷ followers
# multiple). One profile read per uncached account, in data/_owner_profiles.json.
OWNER_CACHE_HOURS=168
# Fresh owner reads allowed per niche search; cached handles are free and do
# not count against this. Twelve is the plan's stated per-niche cap.
OWNER_PROFILE_MAX=12
# Peers kept per plan, and fresh follower reads bought while discovering them.
# Similar accounts, the phrase search and top-reel owners provide the
# candidates; sizes come from the owner cache first and these reads second.
PEER_MAX=6
PEER_LOOKUP_MAX=6
# The smallest size-matched peer set the plan will quote as "accounts your
# size". Below this it compares against the whole room instead. Default 3.
PEER_MIN_COHORT=3

# The deep pass: buys the few posts that decide the question (comments + MP4),
# then reads the video locally with whisper.cpp + macOS Vision, for 0 credits.
# Six posts a plan. Cached a week, so a rebuild for the same account is free.
ENRICH_MAX_CREDITS=6
# Never spend the key below this many credits.
ENRICH_CREDIT_RESERVE=5
# Accounts topped up with their own profile feed during a niche search. The
# paid cap is a budget; the free reader is patience-bound, so it reads more.
ENRICH_ACCOUNTS=6
FREE_ENRICH_ACCOUNTS=32
# Comment calls bought for thin posts in a plan, and the language-verification
# caps: reels watched to settle a language, posts bought for their comments, and
# the hard credit ceiling on that paid step. LANG_COMMENT_MAX=0 turns it off.
ENRICH_COMMENTS_MAX=4
LANG_VERIFY_MAX=8
LANG_COMMENT_MAX=4
LANG_COMMENT_CREDITS=4
POST_CACHE_HOURS=168
# Where whisper looks for a model when WHISPER_MODEL is unset.
WHISPER_MODEL=

# Paid transcript fallback, OFF by default: only for a machine with no local
# whisper model, and capped at one reel per run (10 credits each).
HOOK_PAID_TRANSCRIPT=0
HOOK_PAID_TRANSCRIPT_CAP=1

# YouTube Shorts via the official API (free, 10k units/day).
# https://console.cloud.google.com → enable "YouTube Data API v3" → API key.
YOUTUBE_API_KEY=
# Keyless YouTube page reader. On by default; set 0 to forbid it entirely.
YOUTUBE_WEB=1

# ── Weekly job ────────────────────────────────────────────────────────────────
# Enables GET /api/cron/weekly (header `x-cron-secret` only). Leave blank to
# disable the cron route.
CRON_SECRET=
# Max accounts refreshed per cron invocation.
WEEKLY_MAX=3

# ── Vendor canary ─────────────────────────────────────────────────────────────
# GET /api/cron/canary (header `x-cron-secret` only) spends one profile read per
# configured Instagram vendor and writes a `vendor_canary` row for each.
# The fixed public handle every vendor is asked for.
CANARY_HANDLE=natgeo
# Real-money ceiling for one canary run, in USD (default 0.25). Vendors whose
# next read would cross it are skipped, not tested.
CANARY_MAX_USD=0.25
# Optional http(s) webhook; a failed canary POSTs {text, failures:[…]} here.
CANARY_WEBHOOK_URL=

# ── Google sign-in ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# The authorised redirect URI must be exactly {APP_URL}/api/auth/google/callback
# and APP_URL must match what the browser's address bar shows.
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Runtime ───────────────────────────────────────────────────────────────────
# Where per-visitor accounts and shared caches live. Defaults to ./data.
CREATORS_DATA_DIR=
# Force the session cookie's Secure flag on/off when testing over LAN/HTTP.
COOKIE_SECURE=

# ── Waitlist ──────────────────────────────────────────────────────────────────
# Global signup ceiling per hour across all IPs. The per-IP cap is 10/hour and
# one contact is capped at 5/hour; this is the backstop when a client can rotate
# or spoof x-forwarded-for. Default 300; leave blank to keep the default.
WAITLIST_GLOBAL_PER_HOUR=300

# ── Authenticity sample ───────────────────────────────────────────────────────
# Follower pages bought for the authenticity estimate. Default 0 (off): one
# page holds ~25 rows, below the 40-row floor the estimate needs, so sampling is
# dormant until a verified cursor allows paging. Set positive to turn it on.
AUTH_SAMPLE_PAGES=0

# ── Video reading (optional) ──────────────────────────────────────────────────
# A Gemini key turns on watching the reel's own MP4. Without it, profiles are
# captions-only and say so; nothing breaks.
#
# IMPORTANT: Gemini is billed by Google per token, OUTSIDE the gem balance. A
# video read never spends gems.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Reels watched per profile, one at a time, inside a 90-second budget. Default
# 6, capped at 12.
#
# IMPORTANT: VIDEO_READ_MAX=0 does NOT switch video reading off — the env parser
# treats 0 as "unset" and falls back to 6. To disable the feature, leave
# GEMINI_API_KEY blank.
VIDEO_READ_MAX=6

# ── Generation ────────────────────────────────────────────────────────────────
# DeepSeek is the cheapest usable option for bulk extraction.
# DeepSeek V4.1-Flash ≈ $0.15/M in, $0.60/M out (off-peak).
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
# "none" disables hidden reasoning (faster, cheaper, fine for JSON extraction).
LLM_REASONING_EFFORT=none
